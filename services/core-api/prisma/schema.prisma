// ── Procurement chain (Phase 3, 01 §M6) ─────────────────────────────────────

model PurchaseOrder {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  contractorId  String?   @map("contractor_id")
  vendorId      String?   @map("vendor_id") @db.Uuid
  poNo          String    @map("po_no")
  status        String    @default("open") // open|partial|received|cancelled
  totalPaise    BigInt    @default(0) @map("total_paise")
  promisedDate  DateTime? @map("promised_date")
  receivedDate  DateTime? @map("received_date")
  receivedInFull Boolean  @default(false) @map("received_in_full")
  createdAt     DateTime  @default(now()) @map("created_at")

  lines PurchaseOrderLine[]
  grns  Grn[]

  @@unique([tenantId, poNo])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model MaterialStock {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  materialId    String  @map("material_id")
  materialName  String  @map("material_name")
  unit          String
  stockQty      Decimal @map("stock_qty") @db.Decimal(18, 4)
  wacPaise      BigInt  @default(0) @map("wac_paise") // weighted average cost per unit
  avgDailyConsumption Decimal @map("avg_daily_consumption") @db.Decimal(18, 4)
  inboundPoQty  Decimal @default(0) @map("inbound_po_qty") @db.Decimal(18, 4)
  leadTimeDays  Int     @default(7) @map("lead_time_days")
  safetyDays    Int     @default(3) @map("safety_days")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, projectId, materialId])
  @@map("material_stock")
}

// ── Inventory Warehouse Depth INV-01 ────────────────────────────────────────

model StockLedger {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  materialId     String   @map("material_id")
  movementType   String   @map("movement_type") // grn_in|issue|transfer_in|transfer_out|adjustment|return
  qty            Decimal  @map("qty") @db.Decimal(18, 4)
  unitCostPaise  BigInt   @map("unit_cost_paise") // weighted avg cost at movement time
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(18, 4)
  refDocType     String?  @map("ref_doc_type") // grn|issue_note|count|transfer
  refDocNo       String?  @map("ref_doc_no")
  movedAt        DateTime @map("moved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, projectId, materialId])
  @@map("stock_ledger")
}

model StockCount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  countNo      String    @map("count_no")
  projectId    String    @map("project_id") @db.Uuid
  materialId   String    @map("material_id")
  systemQty    Decimal   @map("system_qty") @db.Decimal(18, 4)
  countedQty   Decimal   @map("counted_qty") @db.Decimal(18, 4)
  varianceQty  Decimal   @map("variance_qty") @db.Decimal(18, 4)
  variancePct  Decimal   @map("variance_pct") @db.Decimal(10, 2)
  status       String    @default("pending") // pending|adjusted|rejected
  adjustedBy   String?   @map("adjusted_by")
  adjustedAt   DateTime? @map("adjusted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, countNo])
  @@index([tenantId, status])
  @@map("stock_counts")
}

// ── Procurement chain P1a: vendor → PR → RFQ → quotes → PO → GRN ────────────

model Vendor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  gstin     String?
  status    String   @default("active") // active|suspended|blacklisted
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("vendors")
}

model PurchaseRequisition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  reqNo       String    @map("req_no")
  projectId   String    @map("project_id") @db.Uuid
  requestedBy String    @map("requested_by")
  requiredBy  DateTime? @map("required_by")
  status      String    @default("draft") // draft|approved|cancelled|converted
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lines PurchaseRequisitionLine[]

  @@unique([tenantId, reqNo])
  @@index([tenantId, status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  requisitionId String  @map("requisition_id") @db.Uuid
  materialId    String  @map("material_id")
  materialName  String  @map("material_name")
  unit          String
  qty           Decimal @db.Decimal(18, 4)
  estRatePaise  BigInt  @default(0) @map("est_rate_paise")
  remark        String?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])

  @@index([tenantId, requisitionId])
  @@map("purchase_requisition_lines")
}

model Rfq {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  rfqNo         String    @map("rfq_no")
  requisitionId String    @map("requisition_id") @db.Uuid
  status        String    @default("open") // open|awarded|cancelled
  closesAt      DateTime? @map("closes_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  lines RfqLine[]
  quotes RfqQuote[]

  @@unique([tenantId, rfqNo])
  @@index([tenantId, status])
  @@map("rfqs")
}

model RfqLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  rfqId        String  @map("rfq_id") @db.Uuid
  materialId   String  @map("material_id")
  materialName String  @map("material_name")
  unit         String
  qty          Decimal @db.Decimal(18, 4)

  rfq Rfq @relation(fields: [rfqId], references: [id])

  @@index([tenantId, rfqId])
  @@map("rfq_lines")
}

model RfqQuote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  rfqId        String   @map("rfq_id") @db.Uuid
  vendorId     String   @map("vendor_id") @db.Uuid
  totalPaise   BigInt   @default(0) @map("total_paise")
  deliveryDays Int      @default(0)
  status       String   @default("received") // received|accepted|rejected
  createdAt    DateTime @default(now()) @map("created_at")

  rfq   Rfq            @relation(fields: [rfqId], references: [id])
  lines RfqQuoteLine[]

  @@index([tenantId, rfqId])
  @@map("rfq_quotes")
}

model RfqQuoteLine {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  quoteId    String  @map("quote_id") @db.Uuid
  materialId String  @map("material_id")
  qty        Decimal @db.Decimal(18, 4)
  ratePaise  BigInt  @map("rate_paise")

  quote RfqQuote @relation(fields: [quoteId], references: [id])

  @@index([tenantId, quoteId])
  @@map("rfq_quote_lines")
}

model PurchaseOrderLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  materialId  String  @map("material_id")
  materialName String @map("material_name")
  unit        String
  qty         Decimal @db.Decimal(18, 4)
  ratePaise   BigInt  @map("rate_paise")
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  order PurchaseOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("purchase_order_lines")
}

model Grn {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  grnNo      String   @map("grn_no")
  orderId    String   @map("order_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  status     String   @default("posted") // posted only (receipts are immutable)
  receivedAt DateTime @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id])
  lines GrnLine[]

  @@unique([tenantId, grnNo])
  @@index([tenantId, vendorId])
  @@map("grns")
}

model GrnLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  grnId       String  @map("grn_id") @db.Uuid
  poLineId    String  @map("po_line_id") @db.Uuid
  materialId  String  @map("material_id")
  qty         Decimal @db.Decimal(18, 4)
  acceptedQty Decimal @map("accepted_qty") @db.Decimal(18, 4)
  rejectedQty Decimal @default(0) @map("rejected_qty") @db.Decimal(18, 4)
  remark      String?

  grn Grn @relation(fields: [grnId], references: [id])

  @@index([tenantId, grnId])
  @@map("grn_lines")
}

// ── Contracts & Legal P1b ────────────────────────────────────────────────────

model LegalContract {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  contractNo    String    @map("contract_no")
  title         String
  partyName     String    @map("party_name") // vendor/contractor/landowner/client name
  partyRole     String    @map("party_role") // contractor|vendor|landowner|consultant|client
  status        String    @default("draft") // draft|in_review|active|amended|expired|terminated|closed
  totalPaise    BigInt    @default(0) @map("total_paise")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  clauses     ContractClause[]
  obligations ContractObligation[]
  claims      ContractClaim[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, status])
  @@map("legal_contracts")
}

model ContractClause {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  sectionNo   String   @map("section_no")
  title       String
  bodyText    String   @map("body_text")
  versionNo   Int      @default(1) @map("version_no")
  isStandard  Boolean  @default(true) @map("is_standard")
  riskLevel   String   @default("low") @map("risk_level") // low|medium|high|critical

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@index([tenantId, contractId])
  @@map("contract_clauses")
}

model ContractObligation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  title       String
  description String?
  dueOn       DateTime  @map("due_on")
  status      String    @default("pending") // pending|fulfilled|overdue|waived
  fulfilledAt DateTime? @map("fulfilled_at")
  ownerRole   String    @map("owner_role")

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@map("contract_obligations")
}

model ContractClaim {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  claimNo     String    @map("claim_no")
  raisedBy    String    @map("raised_by") // internal|counterparty
  nature      String    // delay_penalty|scope_change|quality_defect|payment_dispute|force_majeure
  amountPaise BigInt    @default(0) @map("amount_paise")
  status      String    @default("open") // open|under_negotiation|settled|arbitration|rejected
  settledPaise BigInt?  @map("settled_paise")
  settledAt   DateTime? @map("settled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@unique([tenantId, claimNo])
  @@index([tenantId, contractId])
  @@map("contract_claims")
}

// ── FP&A Enterprise Budgeting & Forecasting P1c ─────────────────────────────

model EnterpriseBudget {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fiscalYear  String    @map("fiscal_year") // e.g. "FY2026-27"
  title       String
  versionNo   Int       @default(1) @map("version_no")
  status      String    @default("draft") // draft|submitted|approved|locked|superseded
  totalPaise  BigInt    @default(0) @map("total_paise")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lines     BudgetLine[]
  scenarios ForecastScenario[]

  @@unique([tenantId, fiscalYear, versionNo])
  @@index([tenantId, status])
  @@map("enterprise_budgets")
}

model BudgetLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  budgetId    String  @map("budget_id") @db.Uuid
  costCenter  String  @map("cost_center") // e.g. "CC-EXEC", "PROJECT-A"
  accountCode String  @map("account_code")
  period      String  // e.g. "2026-09"
  amountPaise BigInt  @map("amount_paise")

  budget EnterpriseBudget @relation(fields: [budgetId], references: [id])

  @@index([tenantId, budgetId])
  @@index([tenantId, costCenter, period])
  @@map("budget_lines")
}

model ForecastScenario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  name        String   // e.g. "Base", "Optimistic", "Pessimistic"
  growthBps   Int      @default(0) @map("growth_bps") // basis points (-2000 to +5000)
  inflationBps Int     @default(500) @map("inflation_bps") // 5% default
  createdAt   DateTime @default(now()) @map("created_at")

  budget EnterpriseBudget @relation(fields: [budgetId], references: [id])

  @@index([tenantId, budgetId])
  @@map("forecast_scenarios")
}

// ── Assets / EAM & Maintenance CMMS P2 ──────────────────────────────────────

model Asset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  assetTag         String    @map("asset_tag")
  name             String
  category         String    // heavy_machinery|vehicle|office_equipment|tool|it
  projectId        String?   @map("project_id") @db.Uuid
  location         String?   // site location / warehouse / floor
  status           String    @default("commissioned") // commissioned|in_service|in_maintenance|decommissioned
  purchaseDate     DateTime  @map("purchase_date")
  purchaseValPaise BigInt    @map("purchase_val_paise")
  salvageValPaise  BigInt    @default(0) @map("salvage_val_paise")
  usefulLifeMonths Int       @map("useful_life_months")
  currentMeterVal  Decimal   @default(0) @map("current_meter_val") @db.Decimal(18, 4)
  meterUnit        String?   @map("meter_unit") // hours|km|cycles
  createdAt        DateTime  @default(now()) @map("created_at")

  plans      MaintenancePlan[]
  workOrders WorkOrder[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@map("assets")
}

model MaintenancePlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  assetId       String    @map("asset_id") @db.Uuid
  title         String
  intervalDays  Int?      @map("interval_days") // time-based PM
  meterInterval Decimal?  @map("meter_interval") @db.Decimal(18, 4) // usage-based PM
  lastRunAt     DateTime? @map("last_run_at")
  lastRunMeter  Decimal?  @map("last_run_meter") @db.Decimal(18, 4)
  status        String    @default("active") // active|paused

  asset      Asset       @relation(fields: [assetId], references: [id])
  workOrders WorkOrder[]

  @@index([tenantId, assetId])
  @@map("maintenance_plans")
}

model WorkOrder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  woNo         String    @map("wo_no")
  assetId      String    @map("asset_id") @db.Uuid
  planId       String?   @map("plan_id") @db.Uuid
  type         String    // preventive|corrective|breakdown|inspection
  description  String
  priority     String    @default("medium") // low|medium|high|critical
  status       String    @default("open") // open|in_progress|completed|cancelled
  assignedTo   String?   @map("assigned_to")
  breakdownAt  DateTime? @map("breakdown_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  costPaise    BigInt    @default(0) @map("cost_paise")
  createdAt    DateTime  @default(now()) @map("created_at")

  asset Asset            @relation(fields: [assetId], references: [id])
  plan  MaintenancePlan? @relation(fields: [planId], references: [id])
  spares SpareUsage[]

  @@unique([tenantId, woNo])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("work_orders")
}

model SpareUsage {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  workOrderId String  @map("work_order_id") @db.Uuid
  materialId  String  @map("material_id")
  qty         Decimal @db.Decimal(18, 4)
  unitCostPaise BigInt @map("unit_cost_paise")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([tenantId, workOrderId])
  @@map("spare_usages")
}

// ── Operations Support: Risk, Service, Audit P3 ─────────────────────────────

model RiskRegister {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  riskNo       String    @map("risk_no")
  title        String
  category     String    // financial|safety|compliance|schedule|quality|reputational
  probability  Int       // 1 (low) to 5 (high)
  impact       Int       // 1 (low) to 5 (high)
  riskScore    Int       @map("risk_score") // probability * impact (1 to 25)
  mitigationPlan String? @map("mitigation_plan")
  ownerRole    String    @map("owner_role")
  status       String    @default("open") // open|mitigated|realized|closed
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, riskNo])
  @@index([tenantId, status])
  @@map("risk_registers")
}

model CustomerTicket {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ticketNo     String    @map("ticket_no")
  unitId       String?   @map("unit_id") @db.Uuid
  customerName String    @map("customer_name")
  customerPhone String   @map("customer_phone")
  category     String    // leakage|electrical|plumbing|possession_delay|billing|other
  description  String
  priority     String    @default("medium") // low|medium|high|critical
  dueOn        DateTime  @map("due_on") // SLA target
  status       String    @default("open") // open|assigned|in_progress|resolved|closed
  assignedTo   String?   @map("assigned_to")
  resolvedAt   DateTime? @map("resolved_at")
  csatRating   Int?      @map("csat_rating") // 1 to 5
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, ticketNo])
  @@index([tenantId, status])
  @@map("customer_tickets")
}

model AuditFinding {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  findingNo     String    @map("finding_no")
  auditedModule String    @map("audited_module") // finance|procurement|siteops|hr|sales
  title         String
  description   String
  severity      String    @default("medium") // low|medium|high|critical
  capaPlan      String?   @map("capa_plan") // Corrective & Preventive Action
  dueOn         DateTime  @map("due_on")
  status        String    @default("open") // open|capa_submitted|verified|closed
  assignedTo    String?   @map("assigned_to")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, findingNo])
  @@index([tenantId, status])
  @@map("audit_findings")
}

// ── Treasury & Debt Facilities FPA-02 ───────────────────────────────────────

model DebtFacility {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  facilityNo      String    @map("facility_no")
  lenderName      String    @map("lender_name")
  facilityType    String    // term_loan|construction_finance|cc_od|lap
  sanctionedPaise BigInt    @map("sanctioned_paise")
  drawnPaise      BigInt    @default(0) @map("drawn_paise")
  repaidPaise     BigInt    @default(0) @map("repaid_paise")
  annualRateBps   Int       @map("annual_rate_bps") // e.g. 1050 = 10.5% p.a.
  tenureMonths    Int       @map("tenure_months")
  securedAgainst  String?   @map("secured_against")
  status          String    @default("active") // active|closed|npa
  createdAt       DateTime  @default(now()) @map("created_at")

  transactions DebtTransaction[]

  @@unique([tenantId, facilityNo])
  @@index([tenantId, status])
  @@map("debt_facilities")
}

model DebtTransaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  facilityId   String   @map("facility_id") @db.Uuid
  txnType      String   @map("txn_type") // drawdown|repayment
  amountPaise  BigInt   @map("amount_paise")
  txnDate      DateTime @map("txn_date")
  narration    String?

  facility DebtFacility @relation(fields: [facilityId], references: [id])

  @@index([tenantId, facilityId])
  @@map("debt_transactions")
}

model CashForecastSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  period         String   // "2026-09"
  openingPaise   BigInt   @map("opening_paise")
  inflowPaise    BigInt   @map("inflow_paise")
