// Phase 0 tables — `docs/architecture/05-database-architecture.md`, `02-architecture-c4.md §5`.
// Conventions: tenant_id on every tenant-owned table (RLS enforced, see rls.sql),
// UUIDv7-style ids (uuid default), timestamptz, soft delete via deleted_at where applicable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  entities OrgEntity[]
  users    User[]

  @@map("tenants")
}

model OrgEntity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  legalName String   @map("legal_name")
  gstin     String?
  stateCode String?  @map("state_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  verticals Vertical[]
  projects  Project[]

  @@index([tenantId])
  @@map("org_entities")
}

model Vertical {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  entityId  String   @map("entity_id") @db.Uuid
  name      String
  segment   String // residential | commercial | plotted | mixed | redevelopment
  createdAt DateTime @default(now()) @map("created_at")

  tenant   OrgEntity @relation(fields: [entityId], references: [id])
  projects Project[]

  @@index([tenantId])
  @@map("verticals")
}

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  entityId    String    @map("entity_id") @db.Uuid
  verticalId  String    @map("vertical_id") @db.Uuid
  code        String
  name        String
  segmentKind String    @map("segment_kind")
  city        String?
  state       String?
  reraNumber  String?   @map("rera_number")
  status      String    @default("planning")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  entity   OrgEntity @relation(fields: [entityId], references: [id])
  vertical Vertical  @relation(fields: [verticalId], references: [id])
  units    Unit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("projects")
}

model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  code      String
  tower     String?
  floor     Int?
  unitType  String?  @map("unit_type")
  carpetSqm Decimal? @map("carpet_sqm") @db.Decimal(12, 2)
  sbuaSqm   Decimal? @map("sbua_sqm") @db.Decimal(12, 2)
  state     String   @default("available") // available|held|blocked|booked|registered|cancelled
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@unique([tenantId, projectId, code])
  @@index([tenantId, state])
  @@map("units")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  phone        String?
  fullName     String    @map("full_name")
  passwordHash String?   @map("password_hash") // WP-0D: OTP-first; password optional
  mfaSecret    String?   @map("mfa_secret")
  status       String    @default("invited")
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roles  UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  template  String? // template code when cloned from seed
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  grant     String // permission pattern, e.g. "sales.*"
  isDeny    Boolean @default(false) @map("is_deny")

  @@index([roleId])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  scope     String   @default("ALL") // ALL|ENTITY|PROJECT|OWN
  scopeRefs String[] @map("scope_refs")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id")
  ip        String?
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("sessions")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorKind     String   @default("human") @map("actor_kind") // human | ai_agent | system
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  ip            String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_event")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  aggregate   String
  type        String // e.g. "booking.confirmed.v1"
  payload     Json
  actor       Json?
  correlationId String? @map("correlation_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt])
  @@map("outbox")
}

model NumberSeries {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  entityId  String @map("entity_id") @db.Uuid
  seriesKey String @map("series_key") // demand|receipt|aft|invoice|po
  prefix    String
  nextNo    Int    @default(1) @map("next_no")
  gapless   Boolean @default(true)

  @@unique([tenantId, entityId, seriesKey])
  @@map("number_series")
}

// ── Workflow engine (WP-0E, 03 §3 / 09 §1) ─────────────────────────────────

model WorkflowDef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  version   Int      @default(1)
  matrix    Json // MatrixEntry[] — authority matrix as data (ADR-AI3)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key, version])
  @@map("workflow_defs")
}

model WorkflowInstance {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  action          String // matrix action, e.g. "sales.discount"
  state           String    @default("pending") // draft|pending|approved|rejected|withdrawn|expired
  valuePaise      BigInt    @map("value_paise")
  payload         Json
  result          Json?
  initiatorUserId String    @map("initiator_user_id") @db.Uuid
  correlationId   String?   @map("correlation_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tasks ApprovalTask[]

  @@index([tenantId, state])
  @@map("workflow_instances")
}

model ApprovalTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  instanceId     String    @map("instance_id") @db.Uuid
  sequence       Int       @default(1) // 1 = approver, 2 = checker (maker-checker)
  state          String    @default("pending") // pending|approved|rejected|query|escalated|cancelled
  assignedRole   String    @map("assigned_role")
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  slaDue         DateTime  @map("sla_due")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decision       String?
  comment        String?
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])

  @@index([tenantId, assignedRole, state])
  @@map("approval_tasks")
}

model Delegation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fromUserId   String   @map("from_user_id") @db.Uuid
  toUserId     String   @map("to_user_id") @db.Uuid
  actionClasses String[] @map("action_classes")
  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, toUserId])
  @@map("delegations")
}

// ── Notification hub (WP-0H, 01 §M11 / 05 §1–3 / 20) ────────────────────────

model NotificationTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  channel        String // whatsapp | email | sms
  locale         String   @default("en")
  category       String   @default("utility") // utility | marketing | authentication
  subject        String? // email only
  body           String // {{var}} placeholders
  approvalStatus String   @default("not_required") @map("approval_status") // whatsapp HSM: pending|approved|rejected
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key, channel, locale, version])
  @@map("notification_templates")
}

model ConsentLedger {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  personRef String    @map("person_ref") // phone/email/user id
  channel   String // whatsapp | email | sms
  purpose   String // transactional | promotional
  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  source    String? // dpdp notice | whatsapp optin | stop keyword
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, personRef, channel, purpose])
  @@map("consent_ledger")
}

model MessageLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  channel        String
  templateKey    String?   @map("template_key")
  toRef          String    @map("to_ref")
  toAddress      String    @map("to_address")
  vars           Json?
  status         String // queued|sent|delivered|read|failed|suppressed|deferred
  failureReason  String?   @map("failure_reason")
  deferUntil     DateTime? @map("defer_until")
  journeyId      String?   @map("journey_id") @db.Uuid
  correlationId  String?   @map("correlation_id")
  providerId     String?   @map("provider_id")
  sentAt         DateTime? @map("sent_at")
  statusUpdatedAt DateTime @default(now()) @map("status_updated_at")

  @@index([tenantId, toRef])
  @@index([tenantId, status])
  @@map("message_log")
}

model Journey {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  definition Json // steps per journey.ts
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@map("journeys")
}

model JourneyState {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  journeyId  String    @map("journey_id") @db.Uuid
  personRef  String    @map("person_ref")
  stepIndex  Int       @default(0) @map("step_index")
  status     String    @default("running") // running|completed|stopped
  context    Json?
  nextRunAt  DateTime? @map("next_run_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, journeyId, status])
  @@map("journey_states")
}

// ── Document vault (WP-0F, 01 §M12 / 03 WP-0F / 15) ─────────────────────────

model Document {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  folderPath    String    @map("folder_path") // "/legal/approvals"
  name          String
  docClass      String    @map("doc_class") // drawing|contract|boq|invoice|approval|certificate|site_photo|policy|other
  currentVersion Int      @default(0) @map("current_version")
  createdBy     String    @map("created_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  versions DocumentVersion[]

  @@unique([tenantId, folderPath, name])
  @@index([tenantId, projectId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  storageKey String   @unique @map("storage_key")
  sizeBytes  Int      @map("size_bytes")
  mimeType   String   @map("mime_type")
  sha256     String
  uploadedBy String   @map("uploaded_by") @db.Uuid
  ocrStatus  String   @default("pending") @map("ocr_status") // pending|processed|failed (WP: doc-intelligence)
  expiryAt   DateTime? @map("expiry_at") // certificates/approvals
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

// ── CRM (Phase 1 WP-1A, 01 §M2) ─────────────────────────────────────────────

model Lead {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  source           String // website | meta_ads | google_ads | portal | whatsapp | ivr | walkin | partner | import
  sourceRef        String?   @map("source_ref") // provider lead id (dedupe + recon)
  campaignId       String?   @map("campaign_id")
  fullName         String    @map("full_name")
  phone            String // normalized +91XXXXXXXXXX
  email            String?
  budgetPaise      BigInt?   @map("budget_paise")
  segment          String?
  language         String    @default("en")
  status           String    @default("new") // new|contacted|qualified|visit_scheduled|visited|negotiation|booking|won|lost
  lostReason       String?   @map("lost_reason")
  score            Int       @default(0)
  assignedUserId   String?   @map("assigned_user_id") @db.Uuid
  slaRespondBy     DateTime? @map("sla_respond_by")
  firstRespondedAt DateTime? @map("first_responded_at")
  dedupFlag        String?   @map("dedup_flag") // duplicate|linked (with matchLeadId)
  matchLeadId      String?   @map("match_lead_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  interactions Interaction[]

  @@unique([tenantId, source, sourceRef])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@map("leads")
}

model Interaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  type        String // call | whatsapp | email | visit | note
  disposition String?
  notes       String?
  byUserId    String?  @map("by_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId])
  @@map("crm_interactions")
}

model SiteVisit {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  leadId      String    @map("lead_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  scheduledAt DateTime  @map("scheduled_at")
  status      String    @default("scheduled") // scheduled|done|no_show|cancelled
  checkedInAt DateTime? @map("checked_in_at")
  geoLat      Decimal?  @map("geo_lat") @db.Decimal(10, 7)
  geoLng      Decimal?  @map("geo_lng") @db.Decimal(10, 7)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, scheduledAt])
  @@map("site_visits")
}
