  orderId    String   @map("order_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  status     String   @default("posted") // posted only (receipts are immutable)
  receivedAt DateTime @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id])
  lines GrnLine[]

  @@unique([tenantId, grnNo])
  @@index([tenantId, vendorId])
  @@map("grns")
}

model GrnLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  grnId       String  @map("grn_id") @db.Uuid
  poLineId    String  @map("po_line_id") @db.Uuid
  materialId  String  @map("material_id")
  qty         Decimal @db.Decimal(18, 4)
  acceptedQty Decimal @map("accepted_qty") @db.Decimal(18, 4)
  rejectedQty Decimal @default(0) @map("rejected_qty") @db.Decimal(18, 4)
  remark      String?

  grn Grn @relation(fields: [grnId], references: [id])

  @@index([tenantId, grnId])
  @@map("grn_lines")
}

// ── Contracts & Legal P1b ────────────────────────────────────────────────────

model LegalContract {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  contractNo    String    @map("contract_no")
  title         String
  partyName     String    @map("party_name") // vendor/contractor/landowner/client name
  partyRole     String    @map("party_role") // contractor|vendor|landowner|consultant|client
  status        String    @default("draft") // draft|in_review|active|amended|expired|terminated|closed
  totalPaise    BigInt    @default(0) @map("total_paise")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  clauses     ContractClause[]
  obligations ContractObligation[]
  claims      ContractClaim[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, status])
  @@map("legal_contracts")
}

model ContractClause {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  sectionNo   String   @map("section_no")
  title       String
  bodyText    String   @map("body_text")
  versionNo   Int      @default(1) @map("version_no")
  isStandard  Boolean  @default(true) @map("is_standard")
  riskLevel   String   @default("low") @map("risk_level") // low|medium|high|critical

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@index([tenantId, contractId])
  @@map("contract_clauses")
}

model ContractObligation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  title       String
  description String?
  dueOn       DateTime  @map("due_on")
  status      String    @default("pending") // pending|fulfilled|overdue|waived
  fulfilledAt DateTime? @map("fulfilled_at")
  ownerRole   String    @map("owner_role")

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@map("contract_obligations")
}

model ContractClaim {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  claimNo     String    @map("claim_no")
  raisedBy    String    @map("raised_by") // internal|counterparty
  nature      String    // delay_penalty|scope_change|quality_defect|payment_dispute|force_majeure
  amountPaise BigInt    @default(0) @map("amount_paise")
  status      String    @default("open") // open|under_negotiation|settled|arbitration|rejected
  settledPaise BigInt?  @map("settled_paise")
  settledAt   DateTime? @map("settled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract LegalContract @relation(fields: [contractId], references: [id])

  @@unique([tenantId, claimNo])
  @@index([tenantId, contractId])
  @@map("contract_claims")
}

// ── FP&A Enterprise Budgeting & Forecasting P1c ─────────────────────────────

model EnterpriseBudget {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fiscalYear  String    @map("fiscal_year") // e.g. "FY2026-27"
  title       String
  versionNo   Int       @default(1) @map("version_no")
  status      String    @default("draft") // draft|submitted|approved|locked|superseded
  totalPaise  BigInt    @default(0) @map("total_paise")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lines     BudgetLine[]
  scenarios ForecastScenario[]

  @@unique([tenantId, fiscalYear, versionNo])
  @@index([tenantId, status])
  @@map("enterprise_budgets")
}

model BudgetLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  budgetId    String  @map("budget_id") @db.Uuid
  costCenter  String  @map("cost_center") // e.g. "CC-EXEC", "PROJECT-A"
  accountCode String  @map("account_code")
  period      String  // e.g. "2026-09"
  amountPaise BigInt  @map("amount_paise")

  budget EnterpriseBudget @relation(fields: [budgetId], references: [id])

  @@index([tenantId, budgetId])
  @@index([tenantId, costCenter, period])
  @@map("budget_lines")
}

model ForecastScenario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  name        String   // e.g. "Base", "Optimistic", "Pessimistic"
  growthBps   Int      @default(0) @map("growth_bps") // basis points (-2000 to +5000)
  inflationBps Int     @default(500) @map("inflation_bps") // 5% default
  createdAt   DateTime @default(now()) @map("created_at")

  budget EnterpriseBudget @relation(fields: [budgetId], references: [id])

  @@index([tenantId, budgetId])
  @@map("forecast_scenarios")
}

// ── Assets / EAM & Maintenance CMMS P2 ──────────────────────────────────────

model Asset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  assetTag         String    @map("asset_tag")
  name             String
  category         String    // heavy_machinery|vehicle|office_equipment|tool|it
  projectId        String?   @map("project_id") @db.Uuid
  location         String?   // site location / warehouse / floor
  status           String    @default("commissioned") // commissioned|in_service|in_maintenance|decommissioned
  purchaseDate     DateTime  @map("purchase_date")
  purchaseValPaise BigInt    @map("purchase_val_paise")
  salvageValPaise  BigInt    @default(0) @map("salvage_val_paise")
  usefulLifeMonths Int       @map("useful_life_months")
  currentMeterVal  Decimal   @default(0) @map("current_meter_val") @db.Decimal(18, 4)
  meterUnit        String?   @map("meter_unit") // hours|km|cycles
  createdAt        DateTime  @default(now()) @map("created_at")

  plans      MaintenancePlan[]
  workOrders WorkOrder[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@map("assets")
}

model MaintenancePlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  assetId       String    @map("asset_id") @db.Uuid
  title         String
  intervalDays  Int?      @map("interval_days") // time-based PM
  meterInterval Decimal?  @map("meter_interval") @db.Decimal(18, 4) // usage-based PM
  lastRunAt     DateTime? @map("last_run_at")
  lastRunMeter  Decimal?  @map("last_run_meter") @db.Decimal(18, 4)
  status        String    @default("active") // active|paused

  asset      Asset       @relation(fields: [assetId], references: [id])
  workOrders WorkOrder[]

  @@index([tenantId, assetId])
  @@map("maintenance_plans")
}

model WorkOrder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  woNo         String    @map("wo_no")
  assetId      String    @map("asset_id") @db.Uuid
  planId       String?   @map("plan_id") @db.Uuid
  type         String    // preventive|corrective|breakdown|inspection
  description  String
  priority     String    @default("medium") // low|medium|high|critical
  status       String    @default("open") // open|in_progress|completed|cancelled
  assignedTo   String?   @map("assigned_to")
  breakdownAt  DateTime? @map("breakdown_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  costPaise    BigInt    @default(0) @map("cost_paise")
  createdAt    DateTime  @default(now()) @map("created_at")

  asset Asset            @relation(fields: [assetId], references: [id])
  plan  MaintenancePlan? @relation(fields: [planId], references: [id])
  spares SpareUsage[]

  @@unique([tenantId, woNo])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("work_orders")
}

model SpareUsage {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  workOrderId String  @map("work_order_id") @db.Uuid
  materialId  String  @map("material_id")
  qty         Decimal @db.Decimal(18, 4)
  unitCostPaise BigInt @map("unit_cost_paise")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([tenantId, workOrderId])
  @@map("spare_usages")
}

// ── Compliance persistence (Phase 4) ────────────────────────────────────────

model StatutoryFiling {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  kind      String // gst|tds|pf|esic|pt|rera_qpr|roc
  period    String
  dueOn     DateTime @map("due_on")
  status    String   @default("open") // open|filed
  ownerRole String   @map("owner_role")
  filedAt   DateTime? @map("filed_at")

  @@unique([tenantId, kind, period])
  @@map("statutory_filings")
}

model QprFiling {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  stateCode   String   @map("state_code")
  year        Int
  period      String // Q1..Q4 | H1 | H2
  state       String   @default("draft") // draft|in_review|approved|submitted|filed
  payload     Json?
  autofillPct Decimal  @default(0) @map("autofill_pct") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, projectId, year, period])
  @@map("qpr_filings")
}

model DsarRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  personRef  String   @map("person_ref")
  kind       String // access|correction|erasure
  state      String   @default("received") // received|in_progress|completed|partially_completed|rejected
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([tenantId, state])
  @@map("dsar_requests")
}

// ── General Ledger (P0, 05 Finance/Accounting) ──────────────────────────────

model Account {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String // e.g. "1000-ASSETS", "2000-LIAB", "4000-REVENUE"
  name      String
  type      String // asset|liability|equity|revenue|expense
  parentCode String? @map("parent_code")
  isPostable Boolean @default(true) @map("is_postable") // parent accounts are headers only
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("gl_accounts")
}

model FiscalPeriod {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  period   String // 2026-09
  start    DateTime @map("start_date")
  end      DateTime @map("end_date")
  status   String @default("open") // open|soft_closed|hard_closed
  closedBy String? @map("closed_by") @db.Uuid

  @@index([tenantId, status])

  @@unique([tenantId, period])
  @@map("fiscal_periods")
}

model Journal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  voucherNo   String   @map("voucher_no")
  type        String // journal|sales|purchase|receipt|payment|contra
  date        DateTime
  narration   String?
  status      String   @default("draft") // draft|pending_approval|posted|reversed
  reversedBy  String?  @map("reversed_by") @db.Uuid
  reversalOf  String?  @map("reversal_of") @db.Uuid
  postedBy    String?  @map("posted_by") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  lines JournalLine[]

  @@unique([tenantId, voucherNo])
  @@index([tenantId, status])
  @@map("gl_journals")
}

model JournalLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalId    String  @map("journal_id") @db.Uuid
  accountCode  String  @map("account_code")
  debitPaise   BigInt  @map("debit_paise")
  creditPaise  BigInt  @map("credit_paise")
  costCenter   String? @map("cost_center")
  description  String?

  journal Journal @relation(fields: [journalId], references: [id])

  @@index([journalId])
  @@index([accountCode])
  @@map("gl_journal_lines")
}

model VendorInvoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  vendorId       String   @map("vendor_id")
  invoiceNo      String   @map("invoice_no")
  invoiceDate    DateTime @map("invoice_date")
  amountPaise    BigInt   @map("amount_paise")
  gstAmountPaise BigInt   @default(0) @map("gst_amount_paise")
  tdsBps         Int      @default(0) @map("tds_bps")
  status         String   @default("pending") // pending|3way_matched|approved|paid|rejected
  matchResult    Json?    @map("match_result")
  glJournalId    String?  @map("gl_journal_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, vendorId, invoiceNo])
  @@index([tenantId, status])
  @@map("vendor_invoices")
}

model BankAccount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  accountNo   String   @map("account_no")
  bankName    String   @map("bank_name")
  ifsc        String
  isEscrow    Boolean  @default(false) @map("is_escrow")
  balancePaise BigInt  @default(0) @map("balance_paise")

  @@unique([tenantId, accountNo])
  @@map("bank_accounts")
}

model BankTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  date           DateTime
  amountPaise    BigInt   @map("amount_paise") // signed: +ve credit, -ve debit
  narration      String
  utr            String?  @map("utr")
  matched        Boolean  @default(false)
  matchedType    String?  @map("matched_type") // receipt|payment|journal
  matchedId      String?  @map("matched_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, utr])
  @@index([tenantId, bankAccountId, matched])
  @@map("bank_transactions")
}
