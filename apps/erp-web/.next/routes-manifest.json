{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/crm/leads/[id]",
      "regex": "^/crm/leads/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/crm/leads/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/crm",
      "regex": "^/crm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/crm(?:/)?$"
    },
    {
      "page": "/finance/collections",
      "regex": "^/finance/collections(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/collections(?:/)?$"
    },
    {
      "page": "/finance/demands",
      "regex": "^/finance/demands(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/demands(?:/)?$"
    },
    {
      "page": "/finance/escrow",
      "regex": "^/finance/escrow(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/escrow(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/sales/bookings",
      "regex": "^/sales/bookings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sales/bookings(?:/)?$"
    },
    {
      "page": "/sales/bookings/new",
      "regex": "^/sales/bookings/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sales/bookings/new(?:/)?$"
    },
    {
      "page": "/sales/inventory",
      "regex": "^/sales/inventory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sales/inventory(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}