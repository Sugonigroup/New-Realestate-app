{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/crm/leads/[id]",
      "regex": "^/crm/leads/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/crm/leads/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/projects/[id]",
      "regex": "^/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/projects/[id]/certify",
      "regex": "^/projects/([^/]+?)/certify(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)/certify(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/audit",
      "regex": "^/admin/audit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/audit(?:/)?$"
    },
    {
      "page": "/admin/roles",
      "regex": "^/admin/roles(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/roles(?:/)?$"
    },
    {
      "page": "/compliance/calendar",
      "regex": "^/compliance/calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compliance/calendar(?:/)?$"
    },
    {
      "page": "/compliance/rera",
      "regex": "^/compliance/rera(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compliance/rera(?:/)?$"
    },
    {
      "page": "/crm",
      "regex": "^/crm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/crm(?:/)?$"
    },
    {
      "page": "/finance/collections",
      "regex": "^/finance/collections(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/collections(?:/)?$"
    },
    {
      "page": "/finance/demands",
      "regex": "^/finance/demands(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/demands(?:/)?$"
    },
    {
      "page": "/finance/escrow",
      "regex": "^/finance/escrow(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/escrow(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/procurement/ra-bills",
      "regex": "^/procurement/ra\\-bills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/procurement/ra\\-bills(?:/)?$"
    },
    {
      "page": "/sales/bookings",
